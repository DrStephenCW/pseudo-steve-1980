# /etc/systemd/system/pseudo-steve.service
# Install:  sudo cp ps /usr/local/bin/pseudo-steve
#           sudo cp deploy/pseudo-steve.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now pseudo-steve
[Unit]
Description=Pseudo-Steve (1980) web version
After=network.target

[Service]
ExecStart=/usr/local/bin/pseudo-steve -http 127.0.0.1:8080
DynamicUser=yes
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
