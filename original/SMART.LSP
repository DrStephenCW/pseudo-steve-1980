
(DEFPROP FRED
 (LAMBDA NIL
  (COND [(EQ X 3.) (PRINC "its a three")] [T (PRINC "its not a three")]))
 EXPR)

(DEFPROP SETG
 (LAMBDA (G29)
  (PROG (G30)
	(SET (CAR G29) (CADR G29))
	(COND [(SETQ G30 (GET (CAR G29) 'FUNCTION)) (EVAL (LIST G30))])
	(RETURN (CADR G29))))
 FEXPR)

(DEFPROP DS
 (LAMBDA (X)
  (PROG NIL
	(PUT (CAADR X) (CAR X) 'FUNCTION)
	(EVAL (LIST 'DE (CAR X) NIL (CADDR X)))
	(RETURN (CAR X))))
 FEXPR)
