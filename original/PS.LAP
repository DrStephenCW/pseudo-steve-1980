
(SETQ SEARCH NIL)

(LAP PS SUBR)
	(MOVEI 1Q (QUOTE RD) S)
	(CALL 1Q (E NOPRINT) S)
	(CALL 0Q (E TERPRI) S)
	(MOVEI 2Q (QUOTE NIL))
	(MOVEI 1Q (QUOTE "[Hello, I'm Pseudo-Steve.  Type HELP for help.]") S)
	(CALL 2Q (E PRINAC) S)
	(CALL 0Q (E TERPRI) S)
	(MOVEI 1Q (QUOTE 0Q))
	(CALL 1Q (E PROMPT) S)
	(PUSH P (C 0Q 0Q (QUOTE NIL) 0Q))
 TAG1	(CALL 0Q (E GETQUEST) S)
	(MOVEM 1Q (SPECIAL L) S)
	(MOVEI 1Q (QUOTE TOP) S)
	(MOVEM 1Q (SPECIAL CURRENT) S)
	(MOVE 1Q (SPECIAL SEARCH) S)
	(MOVEM 1Q (SPECIAL OSEARCH) S)
	(CLEARM 1Q (SPECIAL SEARCH) S)
	(CALL 0Q (E LOOK) S)
	(MOVEM 1Q 0Q P)
	(JUMPE 1Q TAG6)
	(HLRZ@ 1Q (SPECIAL SEARCH) S)
	(CALL 1Q (E SAY) S)
	(JRST 0Q TAG5)
 TAG6	(HLRZ@ 1Q (SPECIAL SEARCH) S)
	(CALL 1Q (E STRINGP) S)
	(JUMPE 1Q TAG7)
	(MOVEI 2Q (QUOTE NIL))
	(MOVEI 1Q (QUOTE "[I'm not sure I understood.]") S)
	(CALL 2Q (E PRINAC) S)
	(CALL 0Q (E TERPRI) S)
	(HLRZ@ 1Q (SPECIAL SEARCH) S)
	(CALL 1Q (E SAY) S)
	(JRST 0Q TAG5)
 TAG7	(MOVE 2Q 1Q)
	(MOVEI 1Q (QUOTE "[I didn't understand the question, sorry.]") S)
	(CALL 2Q (E PRINAC) S)
	(CALL 0Q (E TERPRI) S)
 TAG5	(JRST 0Q TAG1)
	(SUB P (C 1Q 0Q 1Q 0Q))
	(POPJ P)
	NIL

(LAP GETQUEST SUBR)
