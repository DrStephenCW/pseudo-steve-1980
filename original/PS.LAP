(LAP SAY SUBR)
	(PUSH P 1Q)
	(MOVEI 2Q (QUOTE NIL))
	(MOVEI 1Q (QUOTE 1Q))
	(CALL 2Q (E SPACES) S)
	(MOVE 1Q 0Q P)
	(CALL 1Q (E PRINC) S)
	(MOVEI 2Q (QUOTE NIL))
	(MOVEI 1Q (QUOTE ".") S)
	(CALL 2Q (E PRINAC) S)
	(CALL 0Q (E TERPRI) S)
	(MOVEI 1Q (QUOTE NIL))
	(SUB P (C 1Q 0Q 1Q 0Q))
	(POPJ P)
	NIL

(LAP EXPLAINSEARCH SUBR)
	(JSP 6Q SPECBIND)
	(0Q 1Q (SPECIAL SEARCH) S)
	(JUMPN 1Q TAG6)
	(MOVE 2Q 1Q)
	(MOVEI 1Q (QUOTE "[No history to print.]") S)
	(CALL 2Q (E PRINAC) S)
	(CALL 0Q (E TERPRI) S)
	(JRST 0Q TAG3)
 TAG6	(CALL 0Q (E TERPRI) S)
	(MOVEI 2Q (QUOTE NIL))
	(MOVEI 1Q (QUOTE 1Q))
	(CALL 2Q (E SPACES) S)
	(MOVEI 2Q (QUOTE NIL))
	(MOVEI 1Q (QUOTE "[Search history:]") S)
	(CALL 2Q (E PRINAC) S)
	(CALL 0Q (E TERPRI) S)
	(MOVE 1Q (SPECIAL SEARCH) S)
	(CALL 1Q (E REVERSE) S)
	(PUSH P 1Q)
 TAG1	(MOVE 1Q 0Q P)
	(JUMPE 1Q TAG13)
	(HLRZ@ 1Q 1Q)
	(HRRZ@ 2Q 0Q P)
	(MOVEM 2Q 0Q P)
	(MOVEI 2Q (QUOTE 5Q))
	(CALL 2Q (E SPRINT) S)
	(JRST 0Q TAG1)
 TAG13	(SUB P (C 1Q 0Q 1Q 0Q))
	(CALL 0Q (E TERPRI) S)
 TAG3	(MOVEI 1Q (QUOTE NIL))
	(JRST 0Q SPECSTR)
	NIL

(LAP HELP SUBR)
	(MOVEI 1Q (QUOTE ((2360Q 4Q) (PS . HLP))) S)
	(JCALL 17Q (E TYPE) S)
	NIL

(LAP RF SUBR)
	(CALL 0Q (E DTIME) S)
	(MOVEI 2Q (QUOTE 145Q))
	(CALL 2Q (E REMAINDER) S)
	(CALL 1Q (E EXPLODE) S)
	(PUSH P 1Q)
	(CALL 0Q (E MYPPN) S)
	(CALL 1Q (E CADR) S)
	(CALL 1Q (E EXPLODE) S)
	(MOVE 2Q 1Q)
	(POP P 1Q)
	(CALL 2Q (E *APPEND) S)
	(JCALL 1Q (E READLIST) S)
	NIL

(LAP RD SUBR)
	(CALL 0Q (E RF) S)
	(MOVEI 2Q (QUOTE QRZ) S)
	(CALL 2Q (E CONS) S)
	(CALL 1Q (E NCONS) S)
	(MOVEI 2Q (QUOTE (2360Q 4Q)) S)
	(CALL 2Q (E XCONS) S)
	(JCALL 17Q (E DSKLOG) S)
	NIL

(LAP NOPRINT SUBR)
	(PUSH P 1Q)
	(MOVEI 1Q (QUOTE (2Q NUL: (USED . NOT))) S)
	(CALL 17Q (E OUTPUT) S)
	(MOVEI 2Q (QUOTE NIL))
	(MOVEI 1Q (QUOTE 2Q))
	(CALL 2Q (E OUTC) S)
	(MOVE 1Q 0Q P)
	(CALL 1Q (E NCONS) S)
	(CALL 1Q (E *EVAL) S)
	(MOVEI 2Q (QUOTE NIL))
	(MOVE 1Q 2Q)
	(CALL 2Q (E OUTC) S)
	(MOVEI 1Q (QUOTE NIL))
	(SUB P (C 1Q 0Q 1Q 0Q))
	(POPJ P)
	NIL
